generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ruolo di sistema elevato (promozione solo via `scripts/master-key.ts`).
enum UserRole {
  USER
  OPERATOR
  FLORIST
  AGENCY
  MUNICIPALITY
  ACCOUNTANT
  STAKEHOLDER
  ADMIN
  SUPER_ADMIN
  // Valori legacy mantenuti per retrocompatibilità: esistono già nel DB di produzione.
  // Rimuoverli renderebbe il diff distruttivo (Postgres non sa droppare un valore enum).
  MARKETING_MANAGER
  PARTNER_FLORIST
}

/// Profilazione commerciale Utente (dashboard admin + contesto VERA). Distinto da ChatSession.userType.
enum ProfileUserType {
  NEW
  REGULAR
  SUBSCRIBER
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id              String          @id @default(cuid())
  uniqueCode      String?         @unique // Codice parlante UT- (es. UT-LOM-BG-001)
  email           String          @unique
  name            String?
  roleId          String?
  /**
   * Elevazione Super Admin: impostabile solo dallo script offline master-key.
   */
  systemRole      UserRole        @default(USER) @map("system_role")
  company         String?
  phone           String?
  city            String?         @map("city")
  vatNumber       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  roleExpiresAt   DateTime?
  deletedAt       DateTime?
  passwordHash    String?         @map("password_hash")
  isActive        Boolean         @default(false) @map("is_active")
  invitationToken String?         @unique @map("invitation_token")
  inviteExpiresAt DateTime?       @map("invite_expires_at")
  lastLoginAt     DateTime?       @map("last_login_at")
  avatarUrl       String?         @map("avatar_url")
  hasLeftGoogleReview Boolean     @default(false) @map("has_left_google_review")
  /** Record creati in Modalità Test (sandbox admin). */
  isTest          Boolean         @default(false) @map("is_test")
  /**
   * Profilazione a colori: Nuovo / Abituale / Abbonato.
   * Impostabile dall'Admin; iniettata nel contesto VERA.
   */
  userType        ProfileUserType @default(NEW) @map("user_type")
  /**
   * Date future di consegna/commemorazione (max 10) — prenotazione senza impegno.
   * Formato ISO YYYY-MM-DD. Qualche giorno prima VERA invierà un link WhatsApp di conferma.
   */
  plannedDeliveryDates String[]   @default([]) @map("planned_delivery_dates")
  orders          Order[]
  role            Role?           @relation(fields: [roleId], references: [id])
  confirmedProofs DeliveryProof[]
  /** Relazione M2M con profili defunto (più parenti → stesso defunto). */
  deceasedLinks   UserDeceasedLink[]

  isActivated            Boolean          @default(false) @map("is_activated")
  activationToken        String?          @unique @map("activation_token")
  activationTokenExpires DateTime?        @map("activation_token_expires")
  resetPasswordToken     String?          @unique @map("reset_password_token")
  resetPasswordTokenExpires DateTime?     @map("reset_password_token_expires")
  partner                Partner?
  offerGrants            OfferGrant[]
}

/**
 * Entità dominio «Defunto» (profilo commemorativo condiviso tra parenti e fioristi).
 * Nome tabella storico: DeceasedProfile.
 */
model DeceasedProfile {
  id            String   @id @default(cuid())
  uniqueCode    String?  @unique
  fullName      String
  cemeteryCity  String
  cemeteryName  String?
  phone         String?  @map("phone")
  /** Data di nascita commemorativa (fonte primaria per ricorrenze VERA). */
  birthDate     DateTime? @map("birth_date")
  /** Data di morte / commemorazione (fonte primaria per ricorrenze VERA). */
  deathDate     DateTime? @map("death_date")
  verifiedNotes String?  @db.Text
  photoUrl      String?  @map("photo_url")
  /** Immagine di copertina scheda commemorativa (Vercel Blob). */
  coverUrl      String?  @map("cover_url")
  /**
   * Gallery prove di posa / consegna (URL Blob), denormalizzata dagli ordini.
   * Perché: scheda defunto e GdM devono mostrare tutte le foto anche se arrivate a raffica via WhatsApp.
   */
  deliveryPhotoUrls String[] @default([]) @map("delivery_photo_urls")
  /**
   * Date future commemorative/consegna (max 10, YYYY-MM-DD) — senza impegno d'acquisto.
   * Fonte primaria lato scheda defunto; sincronizzate con gli Utenti collegati in salvataggio.
   */
  plannedDeliveryDates String[] @default([]) @map("planned_delivery_dates")
  orders        Order[]
  userLinks     UserDeceasedLink[]
  partnerLinks  PartnerDeceasedAssignment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Pivot User ↔ Defunto (DeceasedProfile): più utenti possono seguire lo stesso defunto.
model UserDeceasedLink {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  deceasedProfileId String          @map("deceased_profile_id")
  relationship      String?         @db.VarChar(80)
  createdAt         DateTime        @default(now()) @map("created_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deceasedProfile   DeceasedProfile @relation(fields: [deceasedProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, deceasedProfileId])
  @@index([deceasedProfileId])
  @@map("user_deceased_links")
}

/// Pivot Fiorista (Partner) ↔ Defunto: custode floreale di zona/tomba.
model PartnerDeceasedAssignment {
  id                String          @id @default(cuid())
  partnerId         String          @map("partner_id")
  deceasedProfileId String          @map("deceased_profile_id")
  isPrimary         Boolean         @default(true) @map("is_primary")
  createdAt         DateTime        @default(now()) @map("created_at")
  partner           Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deceasedProfile   DeceasedProfile @relation(fields: [deceasedProfileId], references: [id], onDelete: Cascade)

  @@unique([partnerId, deceasedProfileId])
  @@index([deceasedProfileId])
  @@map("partner_deceased_assignments")
}

model Order {
  id                     String            @id @default(cuid())
  status                 OrderStatus       @default(PENDING)
  userId                 String?
  deceasedName           String
  deceasedBirthDate      DateTime?
  deceasedDeathDate      DateTime?
  cemeteryName           String
  cemeteryCity           String
  gravePosition          String?
  deliveryDate           DateTime?
  totalPriceCents        Int
  currency               String            @default("EUR")
  photos                 String[]          @default([])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  customerPhone          String?
  ticketMessage          String?
  buyerCity              String?
  buyerCountry           String?
  buyerFullName          String?
  buyerEmail             String?
  isRecurring            Boolean           @default(false)
  deletedAt              DateTime?
  additionalInstructions String?
  funeralDate            DateTime?
  latitude               Float?
  longitude              Float?
  partnerId              String?
  /**
   * Ragione sociale o nome agenzia lato partner (AnnunciFunebri / integrazioni B2B).
   */
  agencyName             String?           @map("agency_name") @db.VarChar(255)
  /**
   * Email azienda partner (handoff da siti esterni) per notifiche / rendicontazione.
   */
  partnerNotifyEmail     String?           @map("partner_notify_email") @db.VarChar(255)
  partnerPaymentStatus   PaymentStatus     @default(UNPAID)
  orderNumber            String?           @unique
  deliveryProvince       String?           @db.VarChar(2)
  /** Codice corto per link WhatsApp post-consegna (/f/{code}). */
  proofFotoCode          String?           @unique @map("proof_foto_code") @db.VarChar(10)
  proofFotoExpiresAt     DateTime?         @map("proof_foto_expires_at")
  /** Primo ordine assegnato a questo fiorista (workflow VERA Punto A). */
  isFirstOrderForPartner Boolean?          @map("is_first_order_for_partner")
  /** Idempotenza step workflow VERA (puntoA, puntoB, …). */
  veraWorkflowFlags      Json?             @map("vera_workflow_flags")
  veraAlertType          String?           @map("vera_alert_type") @db.VarChar(64)
  veraAlertMessage       String?           @map("vera_alert_message") @db.Text
  veraAlertAt            DateTime?         @map("vera_alert_at")
  veraAlertPriority      String?           @default("normal") @map("vera_alert_priority") @db.VarChar(16)
  orderFrozenAt          DateTime?         @map("order_frozen_at")
  orderFrozenReason      String?           @map("order_frozen_reason") @db.Text
  externalAnnouncementId String?           @map("external_announcement_id") @db.VarChar(255)
  deceasedProfileId      String?
  deceasedProfile        DeceasedProfile?  @relation(fields: [deceasedProfileId], references: [id])
  partner                Partner?          @relation(fields: [partnerId], references: [id])
  user                   User?             @relation(fields: [userId], references: [id])
  items                  OrderItem[]
  offerRedemptions       OfferRedemption[]
  deliveryProof          DeliveryProof?
  memoryGardenOpens      MemoryGardenOpen[]
  grossAmount            Float?            @map("gross_amount")
  stripeFee              Float?            @map("stripe_fee")
  netAmount              Float?            @map("net_amount")
  stripeTransactionId    String?           @map("stripe_transaction_id") @db.VarChar(255)
  /**
   * Compenso fiorista concordato (centesimi) — stessa fonte di Vera WhatsApp.
   * Se null, si calcola da listino/note e si può congelare al primo invio.
   */
  floristCompensationCents Int?            @map("florist_compensation_cents")
  /** Aliquota IVA applicabile al compenso fiorista (es. 0 forfettario, 0.10, 0.22). */
  floristVatRate         Float?            @map("florist_vat_rate")
  /** Stato liquidazione partner (indipendente da partnerPaymentStatus checkout). */
  floristSettlementStatus FloristSettlementStatus @default(PENDING) @map("florist_settlement_status")
  /** Override imponibile accessori IVA 22% (centesimi lordi accessori); null = da righe ordine. */
  accessoryAmountCents   Int?              @map("accessory_amount_cents")
  /** Metodo pagamento / gateway (card, apple_pay, google_pay, paypal, …). */
  paymentMethodLabel     String?           @map("payment_method_label") @db.VarChar(64)
  financeNotes           String?           @map("finance_notes") @db.Text
  /** Record creati in Modalità Test (sandbox admin). */
  isTest                 Boolean           @default(false) @map("is_test")
  customerReceipts       CustomerOrderReceipt[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int     @default(1)
  priceCents Int
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]
}

model Product {
  id               String         @id @default(cuid())
  categoryId       String
  name             String
  slug             String         @unique
  shortDescription String?
  description      String?
  basePriceCents   Int
  currency         String         @default("EUR")
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isBouquet        Boolean        @default(true)
  mediaUrl         String?
  deletedAt        DateTime?
  orderItems       OrderItem[]
  category         Category       @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
}

model Offer {
  id          String            @id @default(cuid())
  name        String
  code        String?           @unique
  type        OfferType
  value       Int
  maxUses     Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean           @default(true)
  rulesJson   Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  redemptions OfferRedemption[]
  grants      OfferGrant[]
}

/**
 * Assegnazione personale di un buono a un numero WhatsApp.
 * Perché: stesso codice (es. FLORE10) può avere scadenze diverse per destinatario.
 */
model OfferGrant {
  id             String            @id @default(cuid())
  offerId        String            @map("offer_id")
  recipientPhone String            @map("recipient_phone") @db.VarChar(32)
  recipientName  String?           @map("recipient_name")
  recipientEmail String?           @map("recipient_email")
  userId         String?           @map("user_id")
  startsAt       DateTime          @default(now()) @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  maxUses        Int               @default(1) @map("max_uses")
  sentAt         DateTime?         @map("sent_at")
  whatsappWamid  String?           @map("whatsapp_wamid") @db.VarChar(128)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  offer          Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  redemptions    OfferRedemption[]

  @@unique([offerId, recipientPhone])
  @@index([recipientPhone])
  @@index([endsAt])
  @@map("offer_grants")
}

model OfferRedemption {
  id            String      @id @default(cuid())
  offerId       String
  orderId       String
  grantId       String?     @map("grant_id")
  buyerEmail    String?
  buyerFullName String?
  usedAt        DateTime    @default(now())
  offer         Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  grant         OfferGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([offerId, usedAt])
  @@index([buyerEmail])
  @@index([grantId])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  aiGenerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model NewsletterLog {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model Partner {
  id              String                  @id @default(cuid())
  coverageArea    String?
  address         String?
  activeOrders    Int                     @default(0)
  adminRating     Float                   @default(5.0)
  internalNotes   String?
  isActive        Boolean                 @default(true)
  isB2B           Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  iban            String?
  whatsappNumber  String?
  deletedAt       DateTime?
  email           String?
  pecAddress      String?
  sdiCode         String?
  taxCode         String?
  vatNumber       String?
  ownerName       String
  shopName        String
  paymentStatus   PaymentStatus           @default(UNPAID)
  province        String?                 @db.VarChar(2)
  uniqueCode      String?                 @unique
  orders          Order[]
  deliveryProofs  DeliveryProof[]
  handoffSessions PartnerHandoffSession[]
  apiCredentials  PartnerApiCredential[]
  deceasedAssignments PartnerDeceasedAssignment[]

  userId          String?                 @unique @map("user_id")
  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/**
 * Dati inviati da siti partner (API legacy `order-data`); scambio via `externalKey` in query su checkout.
 */
model PartnerHandoffSession {
  id          String   @id @default(cuid())
  externalKey String   @unique @map("external_key") @db.VarChar(64)
  payload     Json
  expiresAt   DateTime @map("expires_at")
  partnerId   String?  @map("partner_id")
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("partner_handoff_sessions")
}

/**
 * Credenziali API per `POST /api/external/order-data` senza variabili Vercel (chiave pubblica + segreto).
 */
model PartnerApiCredential {
  id         String    @id @default(cuid())
  partnerId  String    @map("partner_id")
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  label      String
  publicId   String    @unique @map("public_id") @db.VarChar(80)
  secretHash String    @map("secret_hash") @db.Text
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([partnerId])
  @@map("partner_api_credentials")
}

model Supplier {
  id            String            @id @default(cuid())
  companyName   String
  category      String
  contactName   String?
  vatNumber     String?
  taxCode       String?
  sdiCode       String?
  pecAddress    String?
  iban          String?
  paypalEmail   String?
  internalNotes String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  email         String?
  phone         String?
  paymentStatus PaymentStatus     @default(UNPAID)
  uniqueCode    String?           @unique
  invoices      SupplierInvoice[]
}

model SupplierInvoice {
  id             String        @id @default(cuid())
  supplierId     String
  invoiceNumber  String
  invoiceDate    DateTime
  reason         String
  amount         Decimal
  paymentDetails String?
  status         PaymentStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
}

model FloremoriaLog {
  id              Int                      @id @default(autoincrement())
  sessionDate     DateTime                 @default(now()) @map("data_sessione") @db.Date
  tag             String?                  @db.VarChar(50)
  topic           String?                  @map("titolo_argomento") @db.VarChar(255)
  keyPrompt       String?                  @map("prompt_chiave") @db.Text
  shortSummary    String?                  @map("riassunto_breve") @db.Text
  searchVector    Unsupported("tsvector")? @map("search_vector")
  criticalAlarms  String?                  @map("allarmi_critici") @db.Text
  pendingTasks    String?                  @map("in_completamento") @db.Text
  discussedPoints String?                  @map("punti_discussi") @db.Text
  achievedResults String?                  @map("risultati_raggiunti") @db.Text
  fullText        String?                  @map("testo_integrale") @db.Text

  @@map("floremoria_logs")
}

/** Chiave-valore per heartbeat e flag di sistema (es. debounce sync POSTMAN). */
model SystemState {
  key       String   @id @db.VarChar(100)
  value     String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_state")
}

/** Sottoscrizioni Web Push (VAPID) dei dispositivi staff per avvisi WhatsApp. */
model StaffPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("staff_push_subscriptions")
}

/** Mittenti email esclusi dal risponditore automatico assistenza@ (spam, newsletter, robot). */
model EmailBlacklist {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_blacklist")
}

/**
 * Numeri di telefono WhatsApp bloccati dal risponditore automatico VERA.
 * Formato atteso: E.164 senza prefisso «whatsapp:», es. "+393204105305".
 * La logica di controllo vive in /api/whatsapp/webhook.
 */
model PhoneBlacklist {
  id        String   @id @default(cuid())
  phone     String   @unique @db.VarChar(30)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("phone_blacklist")
}

model WhatsAppChatSession {
  id         String               @id @default(cuid())
  phone      String               @unique
  name       String
  userType   String               @default("UNKNOWN")
  status     String               @default("AI_ACTIVE")
  welcomeSent Boolean             @default(false) @map("welcome_sent")
  lastMessage String              @default("") @map("last_message")
  hasPhoto   Boolean              @default(false) @map("has_photo")
  dateLabel  String               @default("oggi") @map("date_label")
  timeLabel  String               @default("") @map("time_label")
  initials   String               @default("UT")
  /** Business-Scoped User ID Meta (es. IT.1349…). */
  bsuid      String?              @db.VarChar(128)
  /** Username WhatsApp pubblico (senza @), se adottato dall'utente. */
  waUsername String?              @map("wa_username") @db.VarChar(100)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  messages   WhatsAppChatMessage[]
  /** Sessione chat di sandbox admin (Modalità Test). */
  isTest     Boolean               @default(false) @map("is_test")

  @@index([isTest])
  @@index([bsuid])
  @@map("whatsapp_chat_sessions")
}

model WhatsAppChatMessage {
  id             String             @id @default(cuid())
  sessionId      String             @map("session_id")
  direction      String
  body           String
  mediaUrl       String?            @map("media_url")
  metadata       Json?
  timestampLabel String             @map("timestamp_label")
  createdAt      DateTime           @default(now()) @map("created_at")
  session        WhatsAppChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("whatsapp_chat_messages")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELIVERING
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
}

/** Liquidazione fiorista nel registro fiscale (distinto dal pagamento cliente). */
enum FloristSettlementStatus {
  PENDING
  BONIFICATO
  RICEVUTA
}

enum OfferType {
  PERCENT
  FIXED
}

model DeliveryProof {
  id              String              @id @default(cuid())
  orderId         String              @unique
  partnerId       String
  userId          String?
  photoBeforeUrl  String?
  photoAfterUrl   String?
  photosBeforeUrls String[]           @default([]) @map("photos_before_urls")
  photosAfterUrls  String[]           @default([]) @map("photos_after_urls")
  /** Canale social sanificato (crop + blur + EXIF strip) — unico ammesso per Meta/LinkedIn. */
  socialReadyAfterUrls  String[]       @default([]) @map("social_ready_after_urls")
  socialReadyPrimaryUrl String?        @map("social_ready_primary_url")
  socialCopyCategory    String?        @map("social_copy_category")
  socialSanitizedAt     DateTime?      @map("social_sanitized_at")
  /** Canali Meta/LinkedIn già pubblicati per questo proof (es. META_INSTAGRAM). */
  socialPublishedChannels String[]     @default([]) @map("social_published_channels")
  timestampBefore DateTime?
  timestampAfter  DateTime?
  gpsLatitude     Float?
  gpsLongitude    Float?
  status          DeliveryProofStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

enum DeliveryProofStatus {
  PENDING
  BEFORE_UPLOADED
  COMPLETED
}

model MemoryGardenOpen {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  buyerEmail String?  @map("buyer_email")
  buyerName  String?  @map("buyer_name")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  openedAt   DateTime @default(now()) @map("opened_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("memory_garden_opens")
}

/// Stato workflow campagne marketing interne (generazione → review Guardiani → pubblicazione).
enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

/// Formato contenuto social (feed, reel, story).
enum ContentFormat {
  FEED_POST
  REEL
  STORY
}

/// Canale di distribuzione campagna (Meta, Google Ads, LinkedIn, TikTok, Shorts, Pinterest).
enum MarketingChannel {
  META_FACEBOOK
  META_INSTAGRAM
  GOOGLE_ADS
  LINKEDIN
  TIKTOK
  YOUTUBE_SHORTS
  PINTEREST
}

/// Campagna marketing FloreMoria (Blob + copy CLEO + hashtag AXEL).
model MarketingCampaign {
  id               String           @id @default(cuid())
  status           CampaignStatus   @default(DRAFT)
  imageUrl         String           // URL dell'immagine su Vercel Blob
  videoUrl         String?          // URL video (reel TikTok/Meta) su Blob, se generato
  imagePrompt      String           @default("") @db.Text // Prompt ZIGGY/ARLO per Imagen
  copy             String           @db.Text // Testo generato da CLEO
  hashtags         String[]         // Hashtag ed elementi semantici generati da AXEL
  targetChannel    MarketingChannel // Canale di destinazione
  contentFormat    ContentFormat    @default(FEED_POST) // Post feed, reel o story
  scheduledFor     DateTime?        @db.Date // Giorno editoriale (Europe/Rome)
  category         String           // Categoria FF (Funerale) o FT (Fiori sulle Tombe)
  rejectionReason  String?          // Nota di rifiuto dei Guardiani per la correzione
  /// ID post sul social (IG media id, FB post id, pin id, video id, …)
  externalId       String?          @map("external_id") @db.VarChar(191)
  publishedAt      DateTime?        @map("published_at")
  /// Snapshot metriche canale (views, reach, likes, comments, …)
  metricsJson      Json?            @map("metrics_json")
  metricsSyncedAt  DateTime?        @map("metrics_synced_at")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, targetChannel, contentFormat, scheduledFor])
  @@index([targetChannel, status, publishedAt])
  @@index([externalId])
  @@map("marketing_campaigns")
}

/// Movimento Stripe sincronizzato (balance_transaction / payout / refund).
model StripeFinanceMovement {
  id                    String   @id @default(cuid())
  stripeId              String   @unique @map("stripe_id") @db.VarChar(128)
  type                  String   @db.VarChar(64)
  reportingCategory     String?  @map("reporting_category") @db.VarChar(64)
  description           String?  @db.Text
  amountCents           Int      @map("amount_cents")
  feeCents              Int      @default(0) @map("fee_cents")
  netCents              Int      @map("net_cents")
  currency              String   @default("eur") @db.VarChar(8)
  status                String?  @db.VarChar(32)
  createdAtStripe       DateTime @map("created_at_stripe")
  availableOn           DateTime? @map("available_on")
  sourceId              String?  @map("source_id") @db.VarChar(128)
  payoutId              String?  @map("payout_id") @db.VarChar(128)
  orderId               String?  @map("order_id")
  metadataJson          Json?    @map("metadata_json")
  syncedAt              DateTime @default(now()) @map("synced_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([type, createdAtStripe])
  @@index([createdAtStripe])
  @@index([payoutId])
  @@map("stripe_finance_movements")
}

/// Fattura mensile commissioni Stripe (Stripe Payments Europe Ltd) + reverse charge.
model StripeServiceInvoice {
  id                    String   @id @default(cuid())
  stripeInvoiceId       String?  @unique @map("stripe_invoice_id") @db.VarChar(128)
  /** Chiave stabile mensile se non esiste invoice Stripe formale (es. 2026-08). */
  periodKey             String   @unique @map("period_key") @db.VarChar(16)
  number                String?  @db.VarChar(64)
  status                String?  @db.VarChar(32)
  issuedAt              DateTime @map("issued_at")
  periodStart           DateTime @map("period_start")
  periodEnd             DateTime @map("period_end")
  currency              String   @default("eur") @db.VarChar(8)
  /** Totale fee lorda in centesimi (commissioni gateway del periodo). */
  totalFeeCents         Int      @map("total_fee_cents")
  /** Imponibile fee (reverse charge UE — IVA non addebitata da Stripe). */
  taxableFeeCents       Int      @default(0) @map("taxable_fee_cents")
  vatReverseChargeCents Int      @default(0) @map("vat_reverse_charge_cents")
  vendorName            String   @default("Stripe Payments Europe Ltd") @map("vendor_name") @db.VarChar(128)
  invoicePdfUrl         String?  @map("invoice_pdf_url") @db.Text
  hostedInvoiceUrl      String?  @map("hosted_invoice_url") @db.Text
  /** Copia locale su Blob / path file, se scaricata. */
  localPdfPath          String?  @map("local_pdf_path") @db.Text
  metadataJson          Json?    @map("metadata_json")
  syncedAt              DateTime @default(now()) @map("synced_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([issuedAt])
  @@index([periodStart, periodEnd])
  @@map("stripe_service_invoices")
}

/// Ricevuta di cortesia / conferma ordine archiviata (HTML su Blob).
model CustomerOrderReceipt {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  orderNumber     String?  @map("order_number") @db.VarChar(64)
  issuedAt        DateTime @map("issued_at")
  /** Periodo fiscale YYYY-QN o YYYY-QM (quadrimestre). */
  periodKey       String   @map("period_key") @db.VarChar(16)
  blobPath        String   @map("blob_path") @db.Text
  blobUrl         String?  @map("blob_url") @db.Text
  contentType     String   @default("text/html; charset=utf-8") @map("content_type") @db.VarChar(128)
  grossCents      Int      @map("gross_cents")
  floralImponibileCents Int @map("floral_imponibile_cents")
  accessoryImponibileCents Int @default(0) @map("accessory_imponibile_cents")
  ivaDebitoCents  Int      @map("iva_debito_cents")
  metadataJson    Json?    @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([issuedAt])
  @@index([periodKey])
  @@index([orderNumber])
  @@map("customer_order_receipts")
}

/// Estratto conto / rendiconto bancario FinecoBank caricato in Contabilità.
model BankStatementDocument {
  id                String   @id @default(cuid())
  fileName          String   @map("file_name") @db.VarChar(255)
  contentType       String   @map("content_type") @db.VarChar(128)
  sizeBytes         Int      @map("size_bytes")
  blobPath          String   @map("blob_path") @db.Text
  blobUrl           String?  @map("blob_url") @db.Text
  storageKind       String   @default("blob") @map("storage_kind") @db.VarChar(16)
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  /** UPLOADED | PARSING | PARSED | RECONCILED | FAILED */
  status            String   @default("UPLOADED") @db.VarChar(24)
  parseError        String?  @map("parse_error") @db.Text
  /** Saldo progressivo finale estratto dal rendiconto (centesimi). */
  closingBalanceCents Int?   @map("closing_balance_cents")
  matchedCount      Int      @default(0) @map("matched_count")
  unmatchedCount    Int      @default(0) @map("unmatched_count")
  metadataJson      Json?    @map("metadata_json")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lines             BankStatementLine[]

  @@index([uploadedAt])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("bank_statement_documents")
}

/// Riga movimento estratta da un rendiconto Fineco (parsing CSV/XLSX/PDF).
model BankStatementLine {
  id                String   @id @default(cuid())
  documentId        String   @map("document_id")
  lineIndex         Int      @map("line_index")
  valueDate         DateTime? @map("value_date")
  accountingDate    DateTime? @map("accounting_date")
  description       String   @db.Text
  /** Importo firmato: +avere / -dare (centesimi). */
  amountCents       Int      @map("amount_cents")
  debitCents        Int?     @map("debit_cents")
  creditCents       Int?     @map("credit_cents")
  balanceCents      Int?     @map("balance_cents")
  /** MATCHED | UNMATCHED | PARTIAL */
  matchStatus       String   @default("UNMATCHED") @map("match_status") @db.VarChar(24)
  matchType         String?  @map("match_type") @db.VarChar(48)
  matchScore        Int?     @map("match_score")
  matchedTxId       String?  @map("matched_tx_id") @db.VarChar(128)
  matchedOrderId    String?  @map("matched_order_id")
  matchNotes        String?  @map("match_notes") @db.Text
  rawJson           Json?    @map("raw_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  document          BankStatementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, lineIndex])
  @@index([matchStatus])
  @@index([accountingDate])
  @@map("bank_statement_lines")
}

/**
 * Batch debounce inbound WhatsApp: accumula messaggi/foto e flush dopo 60s di quiete.
 * Perché: Meta consegna burst spezzati → senza buffer Vera risponde a raffica (caso Matilde).
 */
model WhatsAppInboundDebounceBatch {
  id               String   @id @default(cuid())
  phoneKey         String   @unique @map("phone_key") @db.VarChar(128)
  outboundAddress  String   @map("outbound_address") @db.VarChar(128)
  senderName       String   @default("") @map("sender_name") @db.VarChar(255)
  status           String   @default("PENDING") @db.VarChar(24)
  lastInboundAt    DateTime @map("last_inbound_at")
  flushAfter       DateTime @map("flush_after")
  itemsJson        Json     @map("items_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([status, flushAfter])
  @@map("whatsapp_inbound_debounce_batches")
}

